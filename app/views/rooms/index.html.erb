<% content_for :title, "Rooms" %>
<% admin_view = Current.user&.admin? %>

<header>
  <%= render "shared/nav" %>
  <h1>Rooms</h1>
  <p>
    <% if admin_view %>
      Upcoming bookings by site and room (pending and approved).
    <% else %>
      Browse rooms, see who has booked each time slot, and reserve when available.
    <% end %>
  </p>
</header>

<% if flash[:alert] %>
  <p><mark><%= flash[:alert] %></mark></p>
<% end %>
<% if flash[:notice] %>
  <p><ins><%= flash[:notice] %></ins></p>
<% end %>

<% if @sites.any? %>
  <% @sites.each do |site| %>
    <article class="site-card">
      <header>
        <h2><%= site.name %></h2>
        <% if site.address.present? %>
          <p class="site-address"><%= site.address %></p>
        <% end %>
      </header>

      <% active_rooms = site.rooms.select(&:active).sort_by(&:name) %>
      <% if active_rooms.any? %>
        <div class="room-list">
          <% active_rooms.each do |room| %>
            <section class="room-block">
              <div class="room-heading">
                <h3><%= room.name %></h3>
                <% unless admin_view %>
                  <%= link_to "Reserve", new_reservation_path(room_id: room), role: "button", class: "outline contrast room-reserve" %>
                <% end %>
              </div>

              <% bookings = room.upcoming_bookings %>
              <% if bookings.any? %>
                <figure class="booking-table">
                  <table>
                    <thead>
                      <tr>
                        <th>Booked by</th>
                        <th>Purpose</th>
                        <th>Starts</th>
                        <th>Ends</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% bookings.each do |reservation| %>
                        <tr class="<%= "mine" if !admin_view && reservation.user_id == Current.user&.id %>">
                          <td>
                            <%= reservation.user.name %>
                            <% if !admin_view && reservation.user_id == Current.user&.id %>
                              <small>(you)</small>
                            <% end %>
                          </td>
                          <td><%= reservation.purpose.presence || "—" %></td>
                          <td><%= l(reservation.starts_at, format: :short) %></td>
                          <td><%= l(reservation.ends_at, format: :short) %></td>
                          <td><span class="status status-<%= reservation.status %>"><%= reservation.status %></span></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </figure>
              <% else %>
                <p class="empty-bookings"><em>No upcoming bookings.</em></p>
              <% end %>
            </section>
          <% end %>
        </div>
      <% else %>
        <p><em>No active rooms at this site.</em></p>
      <% end %>
    </article>
  <% end %>
<% else %>
  <p>No sites available.</p>
<% end %>
