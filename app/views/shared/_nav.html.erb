<nav>
  <ul>
    <li><strong><%= link_to "Room Reservation", root_path %></strong></li>
    <li><%= link_to "Rooms", root_path %></li>
    <% unless Current.user&.admin? %>
      <li><%= link_to "Upcoming reservations", upcoming_reservations_path %></li>
      <li><%= link_to "My reservations", reservations_path %></li>
    <% end %>
    <% if Current.user&.admin? %>
      <li><%= link_to "Pending requests", admin_reservations_path %></li>
    <% end %>
  </ul>
  <ul>
    <% if Current.user %>
      <li><small><%= Current.user.name %> (<%= Current.user.role %>)</small></li>
      <li><%= button_to "Sign out", session_path, method: :delete %></li>
    <% end %>
  </ul>
</nav>
