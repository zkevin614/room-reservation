<header class="app-header">
  <nav class="app-nav" aria-label="Main">
    <div class="app-nav-brand">
      <%= link_to root_path, class: "app-nav-title" do %>
        <strong>Room Reservation</strong>
      <% end %>
    </div>

    <ul class="app-nav-links">
      <li><%= nav_link_to "Rooms", root_path, key: :rooms %></li>
      <% unless Current.user&.admin? %>
        <li><%= nav_link_to "Upcoming reservations", upcoming_reservations_path, key: :upcoming_reservations %></li>
        <li><%= nav_link_to "My reservations", reservations_path, key: :my_reservations %></li>
      <% end %>
      <% if Current.user&.admin? %>
        <li><%= nav_link_to "Manage Sites", admin_sites_path, key: :manage_sites %></li>
        <li><%= nav_link_to "Manage Rooms", admin_rooms_path, key: :manage_rooms %></li>
        <li><%= nav_link_to "Pending requests", admin_reservations_path, key: :pending_requests %></li>
      <% end %>
    </ul>

    <% if Current.user %>
      <ul class="app-nav-user">
        <li class="app-nav-user-name"><small><%= Current.user.name %> (<%= Current.user.role %>)</small></li>
        <li><%= button_to "Sign out", session_path, method: :delete, class: "outline secondary app-nav-sign-out" %></li>
      </ul>
    <% end %>
  </nav>
</header>
